# TravelBench — API key template
#
# Copy this file to .env (or add the same lines to ~/.zshrc) and fill in
# the values for the providers you want to run.
#
# .env is gitignored — your real keys never leave your machine.
#
# Required: at least one of (Anthropic, OpenAI, Gemini, DeepSeek).
# `test_generate_tasks.py` defaults to all 4 models in parallel; if a key
# is missing, that model is skipped. Single-model runs use --model <name>.

# ─── Core providers (one per model family) ──────────────────────────────────

# Anthropic — Claude Sonnet 4.5, Claude Opus, etc.
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI — GPT-5.4 etc. Also covers DeepSeek if you route via OpenAI-compat.
OPENAI_API_KEY=sk-proj-...

# Google — Gemini 3.1 Pro Preview etc.
# Either name works; scripts check both.
GEMINI_API_KEY=AIzaSy...
# GOOGLE_API_KEY=AIzaSy...

# DeepSeek (direct) — deepseek-chat, deepseek-reasoner.
DEEPSEEK_API_KEY=sk-...

# ─── Optional providers (for benchmark comparison runs) ─────────────────────

# Doubao (Volcengine ARK) — doubao-seed-2-0-pro etc.
# ARK_API_KEY=...
# VOLC_API_KEY=...        # alternative env name

# Moonshot — kimi-k2.6 etc.
# MOONSHOT_API_KEY=sk-...

# Zhipu — glm-4-7-251222 etc.
# ZHIPU_API_KEY=...
# GLM_API_KEY=...         # alternative env name

# ─── Notes ──────────────────────────────────────────────────────────────────
#
# • This file is loaded by your shell, not by Python. If you keep keys in a
#   .env file at the repo root, source it before running:
#       set -a; source .env; set +a
#   Or use direnv to auto-load on `cd` into the repo.
#
# • To persist across sessions, paste the same `export VAR=value` lines into
#   ~/.zshrc (or ~/.bash_profile on bash).
#
# • Scripts use `os.environ.get(...)` with --api-key as a CLI override.
#   When the env var is set, the --api-key flag is optional.
